{
  "name": "circuit-seance",
  "description": "电路招魂 — Live SPICE simulation in the browser with AI explanation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "eecircuit-engine": "1.9.0",
    "marked": "14.1.3",
    "nanoid": "5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@playwright/test": "1.48.2",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.18.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "^24.1.1",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.0",
    "vite": "6.1.0",
    "vitest": "3.0.4"
  }
